# ---- Required in production ----
NODE_ENV=production
PUBLIC_URL=https://fyzio-demo.fly.dev
DATA_KEY=                # 64 hex chars — run: npm run keygen
APP_SECRET=              # random string — run: npm run keygen
DB_PATH=/data/fyzio.sqlite

# ---- Product ----
APP_NAME=Grooveform
SOLO_MODE=true                       # true = no sign-in, plans, curators or prices shown; everything runs anonymously. false = full marketplace.
ADMIN_IDENTIFIER=you@yourdomain.in   # this mobile/email becomes the platform admin on first sign-in (verifies curators, comps plans)
FREE_EXERCISES=all                   # 'all', or a comma list of exercise ids free for everyone: heelslide,hipabd,wallsit,plank,calfstretch,shoulder_er,shoulder_abd,band_row,pullapart,trapstretch

# ---- Payments (Razorpay, India) ----
# mock = dev/test only: plans activate instantly with no payment.   razorpay = real checkout + webhook.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # set the same secret in Razorpay Dashboard → Webhooks (URL: $PUBLIC_URL/api/billing/webhook/razorpay)
# Prices in paise (GST-inclusive). Defaults: Pro ₹299/mo, ₹1999/yr; Curator ₹999/mo, ₹7999/yr
PRICE_PRO_MONTHLY=29900
PRICE_PRO_YEARLY=199900
PRICE_CURATOR_MONTHLY=99900
PRICE_CURATOR_YEARLY=799900

# ---- OTP delivery ----
# console = print code to server log (dev/test only; also returned to the browser outside production)
# msg91   = SMS in India (DLT-registered template required)      twilio = SMS international      resend = email
NOTIFY_PROVIDER=console
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=Groove <no-reply@yourdomain.in>

# ---- Privacy / retention ----
CONSENT_VERSION=2026-09-2          # bump when the privacy notice changes; users re-consent on next sign-in
GRIEVANCE_CONTACT=privacy@yourdomain.in
ERASURE_GRACE_DAYS=7
AUDIT_RETENTION_DAYS=400
STORE_DIAGNOSTICS=true
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=5
TRUST_PROXY=true
